{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pipsrec",
  "version": "0.1.0",
  "identifier": "local.tradingmemory.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "pipsrec", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
